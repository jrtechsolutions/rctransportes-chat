# Database
DATABASE_URL=postgresql://rc:rc_dev_password@localhost:5432/rc_atendimento?schema=public

# Server
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# JWT
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Microsoft Entra ID (OAuth2 Authorization Code)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=rc-verify-token-dev
WHATSAPP_PHONE_NUMBER_ID_OPERACIONAL=
WHATSAPP_PHONE_NUMBER_ID_CLIENTE=
WHATSAPP_API_VERSION=v21.0

# Login genérico para testes locais (false em produção)
DEV_LOGIN_ENABLED=false
DEV_LOGIN_PASSWORD=teste123

# Chamados de expedição — extração de dados do e-mail por IA
# AI_PROVIDER: anthropic (Claude) ou openai
AI_PROVIDER=anthropic
AI_API_KEY=
# Opcional: sobrescreve o modelo padrão do provedor
AI_MODEL=
AI_TIMEOUT_MS=20000

# Chamados de expedição — e-mail de confirmação ao resolver (SMTP do domínio da RC)
# Porta 465 usa TLS direto; 587 usa STARTTLS. Confirme SPF/DKIM do domínio antes de produção.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RC Transportes <expedicao@rctransportes.com.br>"
